{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-lab.invalid/schemas/run-record.schema.json",
  "title": "Run record (runs/SCHEMA.md, schema_version 2 or 3)",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3
      ]
    },
    "run_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slot": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "BUILD",
        "FIX",
        "WAIT",
        "SECURITY"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "base": {
      "type": [
        "string",
        "null"
      ]
    },
    "pr_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "loop_header": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "goal": {
              "type": "string"
            },
            "verifier": {
              "type": "string"
            },
            "step": {
              "type": "string"
            },
            "stop": {
              "type": "string"
            },
            "budget": {
              "type": "string"
            }
          },
          "required": [
            "goal",
            "verifier",
            "step",
            "stop",
            "budget"
          ],
          "additionalProperties": false
        }
      ]
    },
    "freeze_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "duty": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "role",
          "duty",
          "model",
          "outcome",
          "started_at",
          "finished_at"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "exit": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "exit"
        ],
        "additionalProperties": false
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "exit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "passed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "failed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "skipped": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "new_failures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "exit",
          "passed",
          "failed",
          "skipped",
          "duration_ms",
          "new_failures"
        ],
        "additionalProperties": false
      }
    },
    "perf": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "budget": {
            "type": [
              "number",
              "null"
            ]
          },
          "machine": {
            "type": "string"
          }
        },
        "required": [
          "metric",
          "value",
          "unit",
          "budget",
          "machine"
        ],
        "additionalProperties": false
      }
    },
    "frozen_tests_unchanged": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "frozen_tests_all_ran": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "head_unchanged_by_review": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "mutation_check": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "file_line": {
              "type": "string"
            },
            "went_red": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "file_line",
            "went_red"
          ],
          "additionalProperties": false
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "fix_pass_used": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "unflagged_claims": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "verdict",
            "path",
            "fix_pass_used"
          ],
          "additionalProperties": false
        }
      ]
    },
    "directions_acked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "verdict",
        "screens"
      ],
      "additionalProperties": false
    },
    "redteam": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "issue": {
              "type": [
                "integer",
                "null"
              ]
            },
            "critical": {
              "type": [
                "integer",
                "null"
              ]
            },
            "high": {
              "type": [
                "integer",
                "null"
              ]
            },
            "medium": {
              "type": [
                "integer",
                "null"
              ]
            },
            "low": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seeded_caught": {
              "type": [
                "integer",
                "null"
              ]
            },
            "seeded_total": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "issue",
            "critical",
            "high",
            "medium",
            "low",
            "seeded_caught",
            "seeded_total"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stop_rule": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "limits_hit": {
      "type": [
        "string",
        "null"
      ]
    },
    "tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "needs_will": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "fix_freeze_shas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exemption": {},
    "not_claimed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flakes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test",
          "reruns_base",
          "fails_base",
          "reruns_head",
          "fails_head",
          "classified",
          "quarantine"
        ],
        "properties": {
          "test": {
            "type": "string"
          },
          "reruns_base": {
            "type": "integer"
          },
          "fails_base": {
            "type": "integer"
          },
          "reruns_head": {
            "type": "integer"
          },
          "fails_head": {
            "type": "integer"
          },
          "classified": {
            "enum": [
              "flake",
              "regression"
            ]
          },
          "quarantine": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_date",
    "slot",
    "started_at",
    "finished_at",
    "mode",
    "task_id",
    "phase",
    "branch",
    "base",
    "pr_number",
    "loop_header",
    "freeze_sha",
    "dispatches",
    "checks",
    "suites",
    "perf",
    "frozen_tests_unchanged",
    "frozen_tests_all_ran",
    "head_unchanged_by_review",
    "mutation_check",
    "review",
    "directions_acked",
    "design",
    "redteam",
    "stop_rule",
    "limits_hit",
    "tokens",
    "cost_usd",
    "needs_will",
    "notes"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "schema_version": {
        "const": 3
      }
    },
    "required": [
      "schema_version"
    ]
  },
  "then": {
    "required": [
      "not_claimed",
      "flakes"
    ],
    "properties": {
      "review": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "unflagged_claims"
            ],
            "properties": {
              "unflagged_claims": {}
            }
          }
        ]
      },
      "not_claimed": {},
      "flakes": {}
    }
  }
}
